# Konfiguracja Excellence News. Skopiuj do .env i uzupełnij (albo uruchom node scripts/init-env.ts --llm-key <klucz Gemini>,
# który utworzy .env z losowymi hasłami). Strona dostaje tylko adres serwisu; wszystkie klucze zostają w backendzie.
# Nigdy nie wrzucaj .env do Gita.

# ===== Wymagane =====

# Publiczny adres serwisu: z niego powstają linki, RSS, obrazki udostępniania i MCP.
# W domowej sieci wpisz adres serwera, np. http://192.168.1.50:3000
SITE_URL=http://localhost:3000

# Hasło administratora (min. 12 znaków) do panelu /admin.
ADMIN_PASSWORD=

# Klucze podpisu sesji i proxy obrazków: po jednym losowym ciągu (np. openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Hasło bazy danych przy Dockerze (baza nie jest wystawiona na zewnątrz, ale też ustaw losowe).
POSTGRES_PASSWORD=

# Model: dowolne API zgodne z OpenAI; wszystkie kroki domyślnie używają tego modelu.
# Domyślnie Gemini Flash przez Google AI Studio (darmowy klucz: https://aistudio.google.com → Get API key).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Dodatkowe parametry zapytania (JSON): Gemini Flash rozumuje, niski poziom wystarcza i oszczędza limit.
LLM_EXTRA_JSON={"reasoning_effort":"low"}
# Dodatkowy limit tokenów wyjścia na rozumowanie modelu (dodawany do limitu każdego kroku).
LLM_REASONING_TOKENS=2000
# Gemini widzi obrazy: tytuły i streszczenia wybranych tekstów mogą uwzględniać pierwszy obrazek.
LLM_VISION=true
# Wyłącz, jeśli dostawca nie obsługuje trybu JSON (response_format):
# LLM_JSON_MODE=false

# ===== Opcjonalnie: inne darmowe modele dla wybranych kroków =====
# Gdy limit Gemini nie wystarczy, przenieś część kroków (np. odsiew) do innego dostawcy: dopisz zmienną kroku
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# z nazwą presetu z site/models.ts (np. PREFILTER_MODEL=groq) oraz adres i klucz tego dostawcy:
#   Gemini (gemini-flash, gemini-flash-lite):  GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  GEMINI_API_KEY=(ten sam klucz co wyżej)
#   Groq (groq; darmowy limit dzienny, https://console.groq.com):  GROQ_BASE_URL=https://api.groq.com/openai/v1  GROQ_API_KEY=
#   Cerebras (cerebras; darmowy limit tokenów dziennie, https://cloud.cerebras.ai):  CEREBRAS_BASE_URL=https://api.cerebras.ai/v1  CEREBRAS_API_KEY=
#   Mistral (mistral; https://console.mistral.ai):  MISTRAL_BASE_URL=https://api.mistral.ai/v1  MISTRAL_API_KEY=
# Nazwę modelu presetu można nadpisać, gdy dostawca zmieni ofertę: GEMINI_MODEL, GEMINI_LITE_MODEL, GROQ_MODEL, CEREBRAS_MODEL, MISTRAL_MODEL.

# ===== Opcjonalnie: dokładniejsze grupowanie wydarzeń =====

# Wektory (embeddings): dowolne API /embeddings zgodne z OpenAI. Bez tego serwis też działa: grupowanie szuka
# kandydatów po wspólnych słowach, ale wpisy-sygnały (źródła hot_signal) rzadziej trafią do wydarzeń.
# Gemini ma darmowy model embeddingów:
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# Wymiar wektora (domyślnie taki, jaki zwraca usługa); po zmianie stare wektory zostaną przeliczone:
# EMBEDDING_DIMS=

# ===== Opcjonalnie: płatne usługi pobierania (limity i bezpiecznik budżetu w panelu, w „Ustawieniach”) =====
# Konta X (Twitter): SocialData
# SOCIALDATA_API_KEY=
# Renderowanie stron w przeglądarce, gdy nie da się pobrać treści: Jina Reader
# JINA_API_KEY=

# Konta WeChat (chińskie, płatna usługa Dajiala; w Polsce niepotrzebne):
# DAJIALA_KEY=
# Wektory przez Alibaba DashScope (zamiast EMBEDDING_*; w Polsce niepotrzebne):
# DASHSCOPE_API_KEY=

# ===== Opcjonalnie: Feishu (chiński komunikator; w Polsce zwykle niepotrzebny) =====
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Opcjonalnie: inne =====
# Źródła JSON z API GitHuba dostają wyższy limit z tokenem (darmowy, tylko do odczytu):
# GITHUB_TOKEN=
# Token dla zewnętrznych skryptów wysyłających treści do serwisu (POST /api/ingest/items), min. 16 znaków;
# bez niego punkt jest wyłączony. Używa go np. przepływ n8n z newsletterami (docs/pl/newslettery-n8n.md):
# INGEST_TOKEN=
# Ile wysyłek na minutę na klienta (domyślnie w docker compose 10); 0, gdy limituje reverse proxy:
# INGEST_RATE_LIMIT=10
# Pobieranie źródeł przez proxy:
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Limit ruchu proxy obrazków do serwerów źródłowych (MB na minutę, GB na dzień):
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# true, gdy przed serwisem stoi reverse proxy (Caddy, Nginx, Cloudflare Tunnel): adres odwiedzającego czytany z X-Forwarded-For.
# Gdy serwis jest wystawiony bezpośrednio, zostaw false, żeby nikt nie podrobił adresu.
TRUST_PROXY=false
# MCP przyjmuje tylko zapytania do domeny z SITE_URL (i localhost); inne domeny po przecinku:
# MCP_ALLOWED_HOSTS=
# Po ilu minutach bez nowych treści alarmować (domyślnie ALERTS.quietMinutes z site/site.ts, 360):
# ALERT_QUIET_MINUTES=360
# Codzienne zgłaszanie nowych stron do IndexNow (Bing i in.); klucz to 32 znaki szesnastkowe:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Codzienna kopia bazy do magazynu zgodnego z S3 (AWS S3, Backblaze B2, Cloudflare R2…); podaj domenę z nazwą kubełka:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Poziom logów (domyślnie info) i limit połączeń z bazą (domyślnie 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Nazwa wersji widoczna w panelu („Działanie”) i w /api/health:
# AIHOT_RELEASE=
# Nazwa środowiska (domyślnie production albo development według NODE_ENV):
# AIHOT_ENVIRONMENT=
# Katalog z kluczami w plikach grup (models.env, collectors.env, integrations.env, auth.env) zamiast tutaj:
# AIHOT_CREDENTIALS_DIR=

# ===== Bezpieczniki =====
# Tylko true włącza pobieranie źródeł i wywołania modeli; false albo usunięcie zatrzymuje oba (przydatne przy testach).
# Wszystkie przełączniki *_ENABLED akceptują wyłącznie true; 1, yes czy TRUE znaczą „wyłączone”.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Tylko przy uruchomieniu bez Dockera =====
# DATABASE_URL=postgres://uzytkownik@127.0.0.1:5432/excellence
# API_BASE_URL=http://127.0.0.1:3001
# Katalog na pliki, bufor obrazków i lokalne kopie (domyślnie .data w repozytorium):
# AIHOT_DATA_DIR=/var/lib/excellence-news
# Wejście do panelu bez logowania przy programowaniu (produkcja odmówi startu):
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Pobieranie adresów z sieci lokalnej przy testach (domyślnie zabronione; produkcja odmówi startu):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== Przy docker compose --profile https (własna domena z automatycznym HTTPS) =====
# SITE_DOMAIN=news.przyklad.pl
# Port serwisu na serwerze (docker compose, domyślnie 3000 na wszystkich interfejsach); przy HTTPS tylko dla lokalnego Caddy:
# PORT=127.0.0.1:3000
# Wtedy zmień też TRUST_PROXY na true.
